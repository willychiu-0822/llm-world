# 本機開發用設定（複製成 .env）
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/longjiao_dev
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=you@example.com
AUTH_DEV_LOGIN=true
MODERATION_MODE=filter
# REST_WRITE_RATE_LIMIT_PER_MINUTE=120
# OAuth 登入／回呼的 POST 用同一上限、另一份計數。計數在單一執行個體的記憶體裡。
