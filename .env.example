# 複製成 .env 後再改。這個檔只有占位，沒有任何可用的秘密。不要提交 .env。
# 正式環境不讀這個檔：在平台上設定同名環境變數。NODE_ENV=production 時 AUTH_DEV_LOGIN 一律無效。

NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/longjiao_dev
# 正式環境至少 32 字元。請換成自己產生的隨機字串，不要沿用這行。
SESSION_SECRET=replace-with-your-own-random-string-32b
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=you@example.com
# 本機要「開發用登入」才改成 true。公開部署保持 false 或不要設定。
AUTH_DEV_LOGIN=false
MODERATION_MODE=filter
MODERATION_WORDS=
MCP_RATE_LIMIT_PER_MINUTE=60
DB_POOL_MAX=5
SKIP_MIGRATIONS=false
WEB_DIST=
MIGRATIONS_DIR=
