{
  "name": "llm-world",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lj/server dev",
    "dev:web": "pnpm --filter @lj/web dev",
    "build": "pnpm --filter @lj/web build && pnpm --filter @lj/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @lj/db generate",
    "db:migrate": "pnpm --filter @lj/db migrate",
    "seed:demo": "pnpm --filter @lj/server exec tsx --env-file-if-exists=../../.env src/seed-demo.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
